                    },
                    {
                        "key": "data__to_user_id",
                        "label": "Recipient user ID"
                    }
                ],
                "performSubscribe": {
                    "body": {
                        "events": [
                            "transaction.completed"
                        ],
                        "url": "{{bundle.targetUrl}}"
