{
    "_draft": true,
    "_status": "DRAFT \u2014 not submitted to Zapier, not published, not reviewed. The supported path today is the native Webhooks by Zapier modules described in ../README.md. This file captures the same trigger/create in Zapier Platform shape for a future formal submission.",
    "authentication": {
        "connectionLabel": "BMaGlass Pay account",
        "fields": [
            {
                "helpText": "A key from BMaGlass Pay (bmg_live_... moves real money; bmg_sandbox_... uses simulated money; legacy bmp_ keys keep working). Use a scoped key.",
                "key": "api_key",
                "label": "API key",
                "required": true
            }
        ],
        "test": {
            "headers": {
                "X-Api-Key": "{{bundle.authData.api_key}}"
            },
            "url": "https://hhxwwozpvgktuqutfkhc.supabase.co/functions/v1/developer-api/wallets"
        },
        "type": "custom"
    },
    "creates": {
        "create_payment_link": {
            "display": {
                "description": "Creates a hosted BMaGlass payment link in the key's environment (a sandbox key creates a sandbox link). Currencies: ZMW, USD. Optional fee_payer ('seller' | 'buyer') overrides the merchant's account default for this link; redirect_url offers the buyer a Return to store action; reference is stored as metadata.reference and returned on payment_link.paid.",
                "label": "Create Payment Link"
            },
            "key": "create_payment_link",
            "noun": "Payment Link",
            "operation": {
                "inputFields": [
                    {
                        "key": "title",
                        "label": "Title",
                        "required": true
                    },
                    {
                        "key": "amount",
                        "label": "Amount",
                        "type": "number"
                    },
                    {
                        "choices": [
                            "ZMW",
                            "USD"
                        ],
                        "default": "ZMW",
                        "key": "currency",
                        "label": "Currency"
                    },
                    {
                        "key": "description",
                        "label": "Description"
                    },
                    {
                        "key": "fee_payer",
                        "label": "Who funds the platform fee",
                        "choices": [
                            "seller",
                            "buyer"
                        ],
                        "helpText": "seller (default): the 2.5% fee comes out of what you receive; buyer: the fee is added on top so you receive the full price."
                    },
                    {
                        "key": "redirect_url",
                        "label": "Return URL after payment",
                        "helpText": "Optional https URL the hosted pay page offers as Return to store after a completed payment."
                    },
                    {
                        "key": "reference",
                        "label": "Merchant reference",
                        "helpText": "Optional order reference, stored as metadata.reference on the link and returned on payment_link.paid so the automation can match the payment to the order."
                    }
                ],
                "outputFields": [
                    {
                        "key": "link_code",
                        "label": "Link code"
                    },
                    {
                        "key": "title",
                        "label": "Title"
                    },
                    {
                        "key": "amount",
                        "label": "Amount",
                        "type": "number"
                    },
                    {
                        "key": "currency",
                        "label": "Currency"
                    },
                    {
                        "key": "fee_payer",
                        "label": "Fee payer"
                    },
                    {
                        "key": "fee_amount",
                        "label": "Platform fee",
                        "type": "number"
                    },
                    {
                        "key": "buyer_total",
                        "label": "Buyer total",
                        "type": "number"
                    },
                    {
                        "key": "seller_receives",
                        "label": "Seller receives",
                        "type": "number"
                    },
                    {
                        "key": "redirect_url",
                        "label": "Return URL"
                    }
                ],
                "perform": {
                    "body": {
                        "amount": "{{bundle.inputData.amount}}",
                        "currency": "{{bundle.inputData.currency}}",
                        "description": "{{bundle.inputData.description}}",
                        "title": "{{bundle.inputData.title}}",
                        "fee_payer": "{{bundle.inputData.fee_payer}}",
                        "redirect_url": "{{bundle.inputData.redirect_url}}",
                        "metadata": {
                            "reference": "{{bundle.inputData.reference}}"
                        }
                    },
                    "headers": {
                        "Content-Type": "application/json",
                        "X-Api-Key": "{{bundle.authData.api_key}}"
                    },
                    "method": "POST",
                    "url": "https://hhxwwozpvgktuqutfkhc.supabase.co/functions/v1/developer-api/payment-links"
                },
                "sample": {
                    "amount": 250,
                    "currency": "ZMW",
                    "id": "8f14e45f-ea0b-4b3f-9f2d-3f0d3f8b9c01",
                    "link_code": "12db7755bf28243f",
                    "status": "active",
                    "title": "Order #1042",
                    "fee_payer": "seller",
                    "fee_amount": 6.25,
                    "buyer_total": 250,
                    "seller_receives": 243.75,
                    "redirect_url": null,
                    "metadata": {
                        "reference": "Order #1042"
                    }
                }
            }
        }
    },
    "display": {
