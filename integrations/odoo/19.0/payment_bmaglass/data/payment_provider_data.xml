<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_bmaglass" model="payment.provider">
        <field name="name">BMaGlass Pay</field>
        <field name="code">bmaglass</field>
        <field name="state">disabled</field>
        <field name="is_published">True</field>
        <field name="available_currency_ids" eval="[(6, 0, [ref('base.ZMW'), ref('base.USD')])]"/>
        <field name="payment_method_ids"
               eval="[Command.set([ref('payment_method_bmaglass')])]"/>
        <field name="module_id" ref="base.module_payment_bmaglass"/>
        <field name="redirect_form_view_id" ref="payment_bmaglass.redirect_form"/>
        <field name="company_id" ref="base.main_company"/>
    </record>
</odoo>
