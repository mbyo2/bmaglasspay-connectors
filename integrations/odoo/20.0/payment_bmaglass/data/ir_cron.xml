<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Settlement is push-first: the signed payment_link.paid
         webhook settles a transaction the moment its link is paid.
         This 5-minute reconciliation is the fallback that confirms
         any payment whose webhook delivery was missed. -->
    <record id="ir_cron_bmaglass_reconcile" model="ir.cron">
        <field name="name">BMaGlass Pay: reconcile pending payments</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="state">code</field>
        <field name="code">model._bmaglass_reconcile_pending()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
